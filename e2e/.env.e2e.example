# E2E Test Environment Variables
# Copy this file to .env.e2e and fill in the values
# NEVER commit .env.e2e with real secrets

# Backend path (relative to frontend root)
QUIMERA_BACKEND_PATH=../Projeto-Quimera-PIC-2024

# MongoDB (test instance - different from dev!)
MONGO_ROOT_USERNAME=e2e_user
MONGO_ROOT_PASSWORD=changeme_strong_password
# MONGO_URL is constructed in docker-compose from the above

# Backend
JWT_SECRET=generate_a_32_char_min_secret_here
CORS_ORIGIN=http://127.0.0.1:3000
PORT=8000

# Frontend (for Playwright webServer)
API_BASE_URL=http://127.0.0.1:8001
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:8001
API_TIMEOUT_MS=30000
TEACHER_ACCESS_TOKEN_SECRET=test_teacher_secret_min_32_chars_long
EXPERIMENT_ACCESS_SECRET=test_experiment_secret_min_32_chars_long